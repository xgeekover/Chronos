{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": { "includes": ["src/**/*.ts", "src/**/*.tsx", "*.ts"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
